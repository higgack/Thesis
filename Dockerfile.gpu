FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2-dev libxslt1-dev git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
# CUDA 12.1 torch wheel — matches the NVIDIA driver shipped on COS-gpu
# images and the T4 / L4 / A100 GPUs offered on GCE. Sentence-transformers
# rides on top of this same torch install. Image is ~5 GB vs ~1 GB on
# the CPU-only build, but the speedup on BGE-M3 forward passes is the
# whole point.
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cu121 torch && \
    pip install .

COPY src ./src

CMD ["python", "-m", "src.bot"]
