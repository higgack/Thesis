TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=

# Optional: Local Bot API server (lifts 20MB file limit to 2GB).
# Get from https://my.telegram.org/auth -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Set TELEGRAM_BASE_URL to enable local mode (compose service name + port).
# TELEGRAM_BASE_URL=http://telegram-bot-api:8081/bot

GOOGLE_API_KEY=

# Gemini backend. "vertex" (production default) authenticates via GCP ADC
# (no API key needed) and is Free-Trial-credit eligible; "aistudio" uses
# GOOGLE_API_KEY directly. NOTE: config.py currently defaults this to
# "aistudio" if unset — set it explicitly to "vertex" to match production.
GEMINI_BACKEND=vertex
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# Obsidian vault written by the bot, optionally git-pushed to a remote you
# pull from your Obsidian vault (Obsidian Git plugin).
OBSIDIAN_VAULT_PATH=./data/vault
# e.g. https://x-access-token:GITHUB_PAT@github.com/<you>/second-brain-vault.git
OBSIDIAN_GIT_REMOTE=

DATA_DIR=./data
SUMMARY_MODEL=gemini-2.5-flash-lite
ANSWER_MODEL=gemini-2.5-flash
DEEP_MODEL=gemini-2.5-pro
EMBED_MODEL=gemini-embedding-001

# ── Knowledge graph (kg.db) ──
# 1 = each ingested doc's summary is extracted into fact triples in the
# background (one cheap Flash-Lite call/doc). 일일 비용 상한(₩, KST) —
# 도달하면 그날 자동 추출은 스킵(수동 /kg_extract는 영향 없음).
KG_AUTO=1
KG_DAILY_BUDGET_KRW=2000

# ── LLM Wiki (synthesis layer) — ALL OFF BY DEFAULT (see docs/WIKI.md) ──
# Master switch. 1 = build accumulating markdown wiki pages from ingests
# in a nightly batch. 0 = inert (system behaves exactly as before).
WIKI_ENABLED=0
# Lead Q&A with synthesized pages. Only takes effect when WIKI_ENABLED=1.
WIKI_QUERY_FIRST=0
# 일일 비용 상한(₩, KST). 오늘 위키 비용이 이 값에 도달하면 그날 배치는
# 중단되고 알람(ack 버튼)이 옵니다. 자료는 큐에 보존, 다음날 0시 재개. 0=무제한.
WIKI_DAILY_BUDGET_KRW=2000
# Nightly merge runs at this KST hour (off-peak). Uses flash by default.
WIKI_BATCH_HOUR=3
# Cost guards (per nightly run).
WIKI_MIN_SUMMARY_CHARS=600
WIKI_MAX_TOPICS_PER_RUN=25
WIKI_MAX_DOCS_PER_TOPIC=6

# ── MCP server (src/mcp_server/) — exposes the knowledge base to ──
# ── external AI clients (Claude Desktop, GitHub Copilot, Cursor) ──
# Required. A single shared bearer secret — every request must send
# `Authorization: Bearer <MCP_TOKEN>`. Unset = server rejects everything.
MCP_TOKEN=
MCP_PORT=8083
